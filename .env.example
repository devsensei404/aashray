# Copy this file to .env and fill in your own values. .env is git-ignored.
# Digits only. A 10-digit Indian number gets the 91 country code added automatically.
PUBLIC_WHATSAPP_NUMBER=

# Optional. If empty, the WhatsApp number is also used for the phone link.
PUBLIC_PHONE_NUMBER=

# Optional. Leave empty to hide the email row.
PUBLIC_EMAIL=
