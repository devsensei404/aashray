---
const { upiId, payeeName, fallbackImage = '' } = Astro.props;
---
<div class="upi" data-upi-id={upiId} data-payee={payeeName}>
  <h3>Pay by UPI</h3>
  <dl class="facts">
    <dt>UPI ID</dt>
    <dd class="upi-id">{upiId}</dd>
  </dl>

  <label class="field" for="upi-amount">Amount in rupees</label>
  <input id="upi-amount" class="amount" type="text" inputmode="decimal" autocomplete="off" placeholder="Enter an amount" />
  <p class="hint" id="upi-hint" role="status" aria-live="polite">Enter an amount to see a QR code you can scan with any UPI app.</p>

  <div class="qr" id="upi-qr" hidden></div>
  <a class="btn btn--primary pay-link" id="upi-link" href="#" hidden>Pay with a UPI app</a>

  <noscript>
    <p class="hint">Use the UPI ID above in any UPI app.</p>
    {fallbackImage && <img src={fallbackImage} alt="UPI QR code for Aashray for Animals" width="200" height="200" />}
  </noscript>
</div>

<script>
  const root = document.querySelector('.upi');
  if (root) {
    const id = root.dataset.upiId;
    const payee = root.dataset.payee;
    const input = root.querySelector('#upi-amount');
    const hint = root.querySelector('#upi-hint');
    const qrBox = root.querySelector('#upi-qr');
    const link = root.querySelector('#upi-link');
    const idleText = 'Enter an amount to see a QR code you can scan with any UPI app.';
    let timer;

    const render = async () => {
      const raw = input.value.trim();
      if (!raw) {
        qrBox.hidden = true;
        link.hidden = true;
        hint.textContent = idleText;
        return;
      }
      if (!/^\d{1,7}(\.\d{1,2})?$/.test(raw) || Number(raw) <= 0) {
        qrBox.hidden = true;
        link.hidden = true;
        hint.textContent = 'Enter a valid amount, for example 500.';
        return;
      }
      const amount = Number(raw).toFixed(2);
      const uri = `upi://pay?pa=${id}&pn=${encodeURIComponent(payee)}&am=${amount}&cu=INR&tn=Donation`;
      const { default: qrcode } = await import('qrcode-generator');
      if (input.value.trim() !== raw) return;
      const qr = qrcode(0, 'M');
      qr.addData(uri);
      qr.make();
      qrBox.innerHTML = qr.createSvgTag({ cellSize: 4, margin: 4, scalable: true });
      qrBox.querySelector('svg')?.setAttribute('role', 'img');
      qrBox.querySelector('svg')?.setAttribute('aria-label', `UPI QR code for ₹${amount}`);
      qrBox.hidden = false;
      link.href = uri;
      link.hidden = false;
      hint.textContent = `Scan with any UPI app to pay ₹${amount} to ${payee}.`;
    };

    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(render, 150);
    });
  }
</script>

<style>
  .upi { max-width: 36rem; margin-top: 2rem; padding: 1.5rem; border-radius: 1.25rem; background: var(--panel); }
  .upi h3 { margin-bottom: 0.75rem; }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 1.5rem; color: var(--soft); }
  .facts dt { color: var(--ink); }
  .upi-id { overflow-wrap: anywhere; user-select: all; }

  .field { display: block; margin-top: 1.5rem; color: var(--ink); font-weight: 600; }
  .amount {
    display: block;
    width: 100%;
    min-height: 2.75rem;
    margin-top: 0.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
  }
  .amount:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .hint { margin-top: 0.75rem; color: var(--soft); font-size: 0.9375rem; }

  .qr { width: 12.5rem; max-width: 100%; margin-top: 1.25rem; padding: 0.5rem; background: #fff; border-radius: 0.5rem; }
  .qr :global(svg) { display: block; width: 100%; height: auto; }
  .pay-link { margin-top: 1.25rem; }
  .pay-link[hidden] { display: none; }
  @media (hover: hover) and (pointer: fine) { .pay-link { display: none; } }
  .upi noscript img { display: block; max-width: 100%; height: auto; margin-top: 1rem; }
</style>
